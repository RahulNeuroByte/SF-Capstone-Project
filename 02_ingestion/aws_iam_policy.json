{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SnowflakeReadRetailBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::<S3_BUCKET>"
    },
    {
      "Sid": "SnowflakeReadRetailObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::<S3_BUCKET>/globo-retail/*"
    }
  ]
}
